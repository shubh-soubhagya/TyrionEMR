# auth-svc settings (LLD section 21). Placeholders only. Copy to .env (gitignored) and edit.
SERVICE_NAME=auth-svc
LOG_LEVEL=INFO

# Database on the existing Postgres container. "auth_db" already existed there, so this project uses
# nephro_auth_db (see README, Deviations). Host runs use port 5433 (5432 may be shadowed on the host).
AUTH_DB_NAME=nephro_auth_db
AUTH_DB_PW=change-me
AUTH_DATABASE_URL=postgresql+asyncpg://auth_svc:change-me@localhost:5433/nephro_auth_db
AUTH_TEST_DATABASE_URL=postgresql+asyncpg://auth_svc:change-me@localhost:5433/nephro_auth_db_test
AUTH_DB_POOL_SIZE=5
AUTH_DB_MAX_OVERFLOW=5
DB_WAIT_ATTEMPTS=30

JWT_ISSUER=nephro-auth
JWT_AUDIENCE=nephro-api
JWT_PRIVATE_KEY_PATH=setup/keys/jwt_private.pem
JWT_ADDITIONAL_PUBLIC_KEY_PATHS=

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_MAX_DAYS=30
REFRESH_REUSE_GRACE_S=10
REFRESH_RETENTION_DAYS=7
CLEANUP_INTERVAL_S=3600

REFRESH_COOKIE_NAME=nephro_rt
REFRESH_COOKIE_PATH=/api/auth
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=http://localhost:4200

ENABLE_PUBLIC_SIGNUP=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOCKOUT_REVEAL=true

ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=4
ARGON2_MAX_CONCURRENCY=4

SEED_DEMO_USERS=true
UVICORN_WORKERS=2
