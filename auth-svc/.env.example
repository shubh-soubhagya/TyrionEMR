# auth-svc settings (LLD section 21). Placeholders only. Copy to .env (gitignored) and edit.
# Every setting of app/core/config.py is listed with its default; a commented line is optional.

# ---- general ----
SERVICE_NAME=auth-svc
# development | test | production. Production turns on the startup guard and disables /docs and /openapi.json.
ENVIRONMENT=development
LOG_LEVEL=INFO
UVICORN_WORKERS=2

# ---- database roles (create them with setup/init-auth-db.sh) ----
# Database on the existing Postgres container. "auth_db" already existed there, so this project uses
# nephro_auth_db (see README, Deviations).
AUTH_DB_NAME=nephro_auth_db
# auth_app      runtime login: SELECT/INSERT/UPDATE/DELETE on rows (auth_events: SELECT and INSERT only)
# auth_migrator owns the schema, runs Alembic. Never used at runtime.
# docker-compose.yml REQUIRES these four; there is no fallback to the retired single role auth_svc.
AUTH_APP_DB_USER=auth_app
AUTH_APP_DB_PW=change-me
AUTH_MIGRATOR_DB_USER=auth_migrator
AUTH_MIGRATOR_DB_PW=change-me

# Host-run URLs: published port 5433 of the Postgres container (5432 may be shadowed on the host).
# Inside compose the URLs are built from the variables above and point at postgres:5432.
AUTH_DATABASE_URL=postgresql+asyncpg://auth_app:change-me@localhost:5433/nephro_auth_db
# Alembic / `make migrate`. REQUIRED for migrations: there is no fallback to AUTH_DATABASE_URL.
AUTH_MIGRATION_DATABASE_URL=postgresql+asyncpg://auth_migrator:change-me@localhost:5433/nephro_auth_db
# API tests: runtime role, and the schema owner for the migrations and the cleanup between tests
AUTH_TEST_DATABASE_URL=postgresql+asyncpg://auth_app:change-me@localhost:5433/nephro_auth_db_test
AUTH_TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://auth_migrator:change-me@localhost:5433/nephro_auth_db_test

AUTH_DB_POOL_SIZE=5
AUTH_DB_MAX_OVERFLOW=5
DB_WAIT_ATTEMPTS=30
RUN_MIGRATIONS_ON_START=false
# TLS to Postgres: disable | require | verify-full (production needs require or verify-full)
AUTH_DB_SSLMODE=disable
# AUTH_DB_SSLROOTCERT=/run/secrets/db_ca.pem
# Server-side limits on every connection; a lock or statement timeout answers 503 SERVICE_BUSY
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# ---- tokens ----
JWT_ISSUER=nephro-auth
JWT_AUDIENCE=nephro-api
# Host path; compose mounts the key at /run/secrets/jwt_private
JWT_PRIVATE_KEY_PATH=setup/keys/jwt_private.pem
# Comma-separated PEM public keys to keep publishing during a key rotation (setup/rotate-keys.sh)
JWT_ADDITIONAL_PUBLIC_KEY_PATHS=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_MAX_DAYS=30
REFRESH_REUSE_GRACE_S=10

# ---- retention ----
REFRESH_RETENTION_DAYS=7
# Audit rows are purged through purge_auth_events(). MINIMUM 30: startup fails below that.
AUTH_EVENTS_RETENTION_DAYS=365
CLEANUP_INTERVAL_S=3600

# ---- cookie and CORS ----
REFRESH_COOKIE_NAME=nephro_rt
REFRESH_COOKIE_PATH=/api/auth
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---- sign-up and lockout ----
ENABLE_PUBLIC_SIGNUP=true
# Production refuses ENABLE_PUBLIC_SIGNUP=true unless this is also true
ALLOW_PUBLIC_SIGNUP_IN_PRODUCTION=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Failed attempts older than this stop counting toward lockout
LOGIN_FAILURE_WINDOW_MINUTES=15
LOCKOUT_REVEAL=true

# ---- rate limit (in-process, per IP, PER worker process; the gateway is the real limiter) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_LOGIN_BURST=5

# ---- password hashing ----
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=4
ARGON2_MAX_CONCURRENCY=4
# Max wait for a hash slot before 503 SERVICE_BUSY
ARGON2_QUEUE_TIMEOUT_S=2.0

# ---- operations ----
# /metrics is for the internal network only
METRICS_ENABLED=true
# Demo clinicians (synthetic). Production refuses SEED_DEMO_USERS=true.
SEED_DEMO_USERS=true
