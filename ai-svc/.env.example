# ai-svc settings (LLD B2). Placeholders only. Copy to .env (gitignored) and edit.
SERVICE_NAME=ai-svc
APP_ENV=dev
LOG_LEVEL=INFO

# Database on the existing Postgres container (graphgpt-postgres). Host runs use port 5433.
AI_DB_NAME=nephro_ai_db
AI_DB_PW=change-me
AI_DATABASE_URL=postgresql+asyncpg://ai_svc:change-me@localhost:5433/nephro_ai_db
AI_TEST_DATABASE_URL=postgresql+asyncpg://ai_svc:change-me@localhost:5433/nephro_ai_db_test

JWKS_URL=http://auth-svc:8000/.well-known/jwks.json
PATIENT_SVC_URL=http://patient-svc:8000
LAB_SVC_URL=http://lab-svc:8000
CLINIC_TZ=Asia/Kolkata

# LLM provider. The default is Groq. With no LLM_API_KEY the service falls back to the deterministic mock outside
# production, so every feature still works (the summary then says provider "mock"). To use the real model, set
# LLM_API_KEY (or LLM_API_KEY_FILE=/run/secrets/llm_key). LLM_PROVIDER=mock forces the mock.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
# gpt-oss is a reasoning model: reasoning tokens count against this limit (same value as Granthan).
LLM_MAX_OUTPUT_TOKENS=2048
