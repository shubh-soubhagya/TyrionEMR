        "rationale": {
          "maxLength": 400,
          "minLength": 3,
          "title": "Rationale",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "maxLength": 48,
            "pattern": "^(?:pt:(?:pmh|fh|sh|allergy_status|stage)|ckd:latest|(?:cond|med|alg|enc):[1-9][0-9]{0,2}|lab:[A-Z]{1,10}:\\d{4}-\\d{2}-\\d{2}(?:#[2-9])?|trend:[A-Z]{1,10}|gap:[A-Z_]{3,40}(?:#[2-9])?)$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "consideration",
        "rationale",
        "source_refs"
      ],
      "title": "FollowUp",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "maxLength": 48,
            "pattern": "^(?:pt:(?:pmh|fh|sh|allergy_status|stage)|ckd:latest|(?:cond|med|alg|enc):[1-9][0-9]{0,2}|lab:[A-Z]{1,10}:\\d{4}-\\d{2}-\\d{2}(?:#[2-9])?|trend:[A-Z]{1,10}|gap:[A-Z_]{3,40}(?:#[2-9])?)$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "Section",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "history_summary": {
      "$ref": "#/$defs/Section"
    },
    "comorbidity_summary": {
      "$ref": "#/$defs/Section"
    },
    "trend_commentary": {
