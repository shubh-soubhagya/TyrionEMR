{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab/trends.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patient_id",
    "from",
    "to",
    "series"
  ],
  "properties": {
    "patient_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "from": {
      "type": [
        "string",
        "null"
      ]
    },
    "to": {
      "type": [
        "string",
        "null"
      ]
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test_code",
          "unit",
          "points",
          "stats",
          "reference"
        ],
        "properties": {
          "test_code": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "stats": {
            "type": "object",
            "required": [
              "n",
              "direction"
            ],
            "properties": {
              "n": {
                "type": "integer"
              },
              "direction": {
                "type": "string"
              }
            }
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "result_id",
                "collected_at",
                "value",
                "flag"
              ],
              "properties": {
                "result_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "collected_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "value": {
                  "type": "number"
                },
                "flag": {
                  "enum": [
                    "normal",
                    "low",
                    "high",
                    "critical_low",
                    "critical_high",
                    "unknown"
                  ]
                }
              }
            }
          },
          "reference": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "low",
                  "high"
                ],
                "properties": {
                  "low": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "high": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "stage_bands": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "lower"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "lower": {
                      "type": "integer"
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
