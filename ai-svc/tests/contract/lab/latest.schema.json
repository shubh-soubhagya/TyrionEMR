{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab/latest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patient_id",
    "tests",
    "ckd",
    "has_critical",
    "rapid_decline",
    "last_result_at",
    "first_result_at",
    "egfr_lt60_run",
    "status_version",
    "result_count"
  ],
  "properties": {
    "patient_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "tests": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_code",
          "name",
          "canonical_unit",
          "result"
        ],
        "properties": {
          "test_code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "canonical_unit": {
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "result_id",
                  "report_id",
                  "value",
                  "flag",
                  "collected_at",
                  "ref_low",
                  "ref_high"
                ],
                "properties": {
                  "result_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "report_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "value": {
                    "type": "number"
                  },
                  "flag": {
                    "enum": [
                      "normal",
                      "low",
                      "high",
                      "critical_low",
                      "critical_high",
                      "unknown"
                    ]
                  },
                  "collected_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "ref_low": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "ref_high": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "ckd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "egfr_category",
        "egfr_label",
        "egfr_value",
        "egfr_collected_at",
        "uacr_category",
        "uacr_label",
        "uacr_value",
        "uacr_collected_at"
      ],
      "properties": {
        "egfr_category": {
          "type": [
            "string",
            "null"
          ]
        },
        "egfr_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "egfr_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "egfr_collected_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "uacr_category": {
          "type": [
            "string",
            "null"
          ]
        },
        "uacr_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "uacr_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "uacr_collected_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "has_critical": {
      "type": "boolean"
    },
    "rapid_decline": {
      "type": "boolean"
    },
    "last_result_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "status_version": {
      "type": "integer",
      "minimum": 0
    },
    "result_count": {
      "type": "integer",
      "minimum": 0
    },
    "first_result_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "egfr_lt60_run": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "since",
            "n"
          ],
          "properties": {
            "since": {
              "type": "string"
            },
            "n": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    }
  }
}
