# ---- shared ----
LOG_LEVEL=INFO
JWT_ISSUER=nephro-auth
JWT_AUDIENCE=nephro-api
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---- auth-svc ----
# Database name on the existing Postgres container. "auth_db" was already taken there,
# so this project uses nephro_auth_db (see README, "Deviations").
AUTH_DB_NAME=nephro_auth_db
# Least-privilege roles (created by auth-svc/setup/init-auth-db.sh). The retired single role auth_svc and its
# AUTH_DB_PW are gone. Full list of auth settings: auth-svc/.env.example.
AUTH_APP_DB_USER=auth_app
AUTH_APP_DB_PW=change-me
AUTH_MIGRATOR_DB_USER=auth_migrator
AUTH_MIGRATOR_DB_PW=change-me
ENABLE_PUBLIC_SIGNUP=true
SEED_DEMO_USERS=true
COOKIE_SECURE=true
# Host-run tests: published port 5433 of the Postgres container (5432 may be shadowed on the host).
# Runtime role for the tests, and the schema owner for migrations and the cleanup between tests.
AUTH_TEST_DATABASE_URL=postgresql+asyncpg://auth_app:change-me@localhost:5433/nephro_auth_db_test
AUTH_TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://auth_migrator:change-me@localhost:5433/nephro_auth_db_test

# ---- gateway ----
GATEWAY_PORT=8080
