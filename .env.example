# ---- shared ----
LOG_LEVEL=INFO
JWT_ISSUER=nephro-auth
JWT_AUDIENCE=nephro-api
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---- auth-svc ----
# Database name on the existing Postgres container. "auth_db" was already taken there,
# so this project uses nephro_auth_db (see README, "Deviations").
AUTH_DB_NAME=nephro_auth_db
AUTH_DB_PW=change-me
ENABLE_PUBLIC_SIGNUP=true
SEED_DEMO_USERS=true
COOKIE_SECURE=true
# Host-run tests (published port 5432 of the Postgres container)
AUTH_TEST_DATABASE_URL=postgresql+asyncpg://auth_svc:change-me@localhost:5432/nephro_auth_db_test

# ---- gateway ----
GATEWAY_PORT=8080
