{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab/trends.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patient_id",
    "series"
  ],
  "properties": {
    "patient_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_code",
          "unit",
          "points",
          "stats"
        ],
        "properties": {
          "test_code": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "collected_at",
                "value",
                "flag",
                "ref_low",
                "ref_high"
              ],
              "properties": {
                "collected_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "value": {
                  "type": "number"
                },
                "flag": {
                  "type": "string"
                },
                "ref_low": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "ref_high": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "stats": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "n",
                  "direction"
                ],
                "properties": {
                  "n": {
                    "type": "integer"
                  },
                  "direction": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
