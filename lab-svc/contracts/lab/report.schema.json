{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab/report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report",
    "results",
    "summary"
  ],
  "properties": {
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patient_id",
        "collected_at",
        "lab_name",
        "notes",
        "entered_by",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "patient_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "lab_name": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "entered_by": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "test_code",
          "value",
          "unit",
          "value_original",
          "unit_original",
          "ref_low",
          "ref_high",
          "crit_low",
          "crit_high",
          "flag"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "test_code": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "value_original": {
            "type": "number"
          },
          "unit_original": {
            "type": "string"
          },
          "ref_low": {
            "type": [
              "number",
              "null"
            ]
          },
          "ref_high": {
            "type": [
              "number",
              "null"
            ]
          },
          "crit_low": {
            "type": [
              "number",
              "null"
            ]
          },
          "crit_high": {
            "type": [
              "number",
              "null"
            ]
          },
          "flag": {
            "enum": [
              "normal",
              "low",
              "high",
              "critical_low",
              "critical_high",
              "unknown"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "abnormal",
        "critical"
      ],
      "properties": {
        "n": {
          "type": "integer"
        },
        "abnormal": {
          "type": "integer"
        },
        "critical": {
          "type": "integer"
        }
      }
    }
  }
}
