{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab/summary.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patient_id",
          "has_results",
          "latest_egfr",
          "egfr_category",
          "egfr_direction",
          "spark",
          "has_critical",
          "rapid_decline",
          "last_result_at"
        ],
        "properties": {
          "patient_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "has_results": {
            "type": "boolean"
          },
          "latest_egfr": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "flag",
                  "collected_at"
                ],
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "flag": {
                    "enum": [
                      "normal",
                      "low",
                      "high",
                      "critical_low",
                      "critical_high",
                      "unknown"
                    ]
                  },
                  "collected_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "egfr_category": {
            "type": [
              "string",
              "null"
            ]
          },
          "egfr_direction": {
            "type": [
              "string",
              "null"
            ]
          },
          "spark": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "t",
                "v"
              ],
              "properties": {
                "t": {
                  "type": "string"
                },
                "v": {
                  "type": "number"
                }
              }
            }
          },
          "has_critical": {
            "type": "boolean"
          },
          "rapid_decline": {
            "type": "boolean"
          },
          "last_result_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
