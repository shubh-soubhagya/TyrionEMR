{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab/status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "next_cursor"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patient_id",
          "latest",
          "egfr_category",
          "uacr_category",
          "egfr_stats",
          "creat_stats",
          "has_critical",
          "rapid_decline",
          "last_result_at"
        ],
        "properties": {
          "patient_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "latest": {
            "type": "object"
          },
          "egfr_category": {
            "type": [
              "string",
              "null"
            ]
          },
          "uacr_category": {
            "type": [
              "string",
              "null"
            ]
          },
          "egfr_stats": {
            "type": [
              "object",
              "null"
            ]
          },
          "creat_stats": {
            "type": [
              "object",
              "null"
            ]
          },
          "has_critical": {
            "type": "boolean"
          },
          "rapid_decline": {
            "type": "boolean"
          },
          "last_result_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
