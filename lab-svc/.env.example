# lab-svc settings (LLD section 21). Placeholders only. Copy to .env (gitignored) and edit.
SERVICE_NAME=lab-svc
LOG_LEVEL=INFO

# Database on the existing Postgres container (graphgpt-postgres). Host runs use port 5433.
LAB_DB_NAME=nephro_lab_db
LAB_DB_PW=change-me
LAB_DATABASE_URL=postgresql+asyncpg://lab_svc:change-me@localhost:5433/nephro_lab_db
LAB_TEST_DATABASE_URL=postgresql+asyncpg://lab_svc:change-me@localhost:5433/nephro_lab_db_test
LAB_DB_POOL_SIZE=5
LAB_DB_MAX_OVERFLOW=5
DB_WAIT_ATTEMPTS=30

JWKS_URL=http://auth-svc:8000/.well-known/jwks.json
JWKS_CACHE_TTL_S=300
# Clinician display names: GET /auth/me with the caller's own token (tokens carry no PII), cached per user

JWT_ISSUER=nephro-auth
JWT_AUDIENCE=nephro-api

CLINIC_TZ=Asia/Kolkata
RUN_MIGRATIONS_ON_START=true
SEED_ON_START=true
UVICORN_WORKERS=2
PATIENT_SVC_URL=http://patient-svc:8000
