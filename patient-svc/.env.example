# patient-svc settings (LLD section 21). Placeholders only. Copy to .env (gitignored) and edit.
SERVICE_NAME=patient-svc
LOG_LEVEL=INFO

# Database on the existing Postgres container (graphgpt-postgres). Host runs use port 5433.
PATIENT_DB_NAME=nephro_patient_db
PATIENT_DB_PW=change-me
PATIENT_DATABASE_URL=postgresql+asyncpg://patient_svc:change-me@localhost:5433/nephro_patient_db
PATIENT_TEST_DATABASE_URL=postgresql+asyncpg://patient_svc:change-me@localhost:5433/nephro_patient_db_test
PATIENT_DB_POOL_SIZE=5
PATIENT_DB_MAX_OVERFLOW=5
DB_WAIT_ATTEMPTS=30

JWKS_URL=http://auth-svc:8000/.well-known/jwks.json
JWKS_CACHE_TTL_S=300
# Clinician display names: GET /auth/me with the caller's own token (tokens carry no PII), cached per user
AUTH_ME_URL=http://auth-svc:8000/auth/me
CLINICIAN_NAME_CACHE_TTL_S=600
CLINICIAN_NAME_NEGATIVE_TTL_S=30
CLINICIAN_NAME_CACHE_MAX=1000

JWT_ISSUER=nephro-auth
JWT_AUDIENCE=nephro-api

CLINIC_TZ=Asia/Kolkata
RUN_MIGRATIONS_ON_START=true
SEED_ON_START=false
UVICORN_WORKERS=2
